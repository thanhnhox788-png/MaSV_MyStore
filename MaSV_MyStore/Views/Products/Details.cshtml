@model MaSV_MyStore.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>@Model.ProductName</h2>
    <hr />

    <div class="row">
        <div class="col-md-5">
            <img src="~/Images/@Model.ProductImage" class="img-fluid rounded" alt="@Model.ProductName" style="max-height: 400px; object-fit: cover;" />
        </div>
        <div class="col-md-7">
            <h4>Danh mục: <span class="badge bg-secondary">@Model.Category.CategoryName</span></h4>
            <h3 class="text-danger my-3">Đơn giá: @String.Format("{0:N0}", Model.ProductPrice) VNĐ</h3>
            <p><strong>Mô tả sản phẩm:</strong></p>
            <p>@Model.ProductDescription</p>

            <div class="mt-4">
                @using (Html.BeginForm("AddToCart", "Cart", new { id = Model.ProductID }, FormMethod.Post))
                {
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                    </button>
                    @Html.ActionLink("Quay lại trang chủ", "Index", "Home", null, new { @class = "btn btn-outline-secondary btn-lg ms-2" })
                }
            </div>
        </div>
    </div>
</div>