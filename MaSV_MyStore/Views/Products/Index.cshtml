@model IEnumerable<MaSV_MyStore.Models.Product>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý danh sách sản phẩm</h2>
    <span class="badge bg-primary">Tổng số: @Model.Count() sản phẩm</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Mã SP</th>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Đơn giá</th>
            <th width="140">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.ProductID</td>
                <td>
                    <img src="@(string.IsNullOrEmpty(item.ProductImage)
                                ? Url.Content("~/Content/images/no-image.jpg")
                                : Url.Content("~/Content/images/" + item.ProductImage))"
                         alt="@item.ProductName"
                         style="width: 70px; height: 70px; object-fit: cover; border-radius: 6px;"
                         onerror="this.src='@Url.Content("~/Content/images/no-image.jpg")'" />
                </td>
                <td>@item.ProductName</td>
                <td class="text-danger fw-bold">
                    @string.Format("{0:N0}", item.ProductPrice) ₫
                </td>
                <td>
                    <a href="@Url.Action("Edit", new { id = item.ProductID })" class="btn btn-warning btn-sm">
                        Sửa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>