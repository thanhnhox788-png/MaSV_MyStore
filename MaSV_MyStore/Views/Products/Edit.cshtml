@model MaSV_MyStore.Models.Product

@{
    ViewBag.Title = "Sửa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">Sửa sản phẩm</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ProductID)
    @Html.HiddenFor(m => m.CategoryID)

    <div class="row">
        <div class="col-md-8">
            <div class="mb-3">
                <label class="form-label">Tên sản phẩm</label>
                @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                <label class="form-label">Mô tả</label>
                @Html.TextAreaFor(m => m.ProductDescription, new { @class = "form-control", rows = 4 })
            </div>

            <div class="mb-3">
                <label class="form-label">Đơn giá (VNĐ)</label>
                @Html.TextBoxFor(m => m.ProductPrice, new { @class = "form-control", type = "number", step = "1000" })
            </div>

            <div class="mb-3">
                <label class="form-label">Tên file hình ảnh</label>
                @Html.TextBoxFor(m => m.ProductImage, new { @class = "form-control", placeholder = "ví dụ: conan.jpg" })
                <div class="form-text">Ảnh phải được đặt trong thư mục <strong>Content/images</strong></div>
            </div>

            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
}