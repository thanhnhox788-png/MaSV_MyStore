@model MaSV_MyStore.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;">
    <h2>XÓA SẢN PHẨM</h2>

    <h3 class="text-danger">Bạn có chắc chắn muốn xóa sản phẩm này không?</h3>
    <div>
        <h4>Product</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                Danh mục
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Category.CategoryName)
            </dd>

            <dt>
                Tên sản phẩm
            </dt>
            <dd>
                @Html.DisplayFor(model => model.ProductName)
            </dd>

            <dt>
                Mô tả
            </dt>
            <dd>
                @Html.DisplayFor(model => model.ProductDescription)
            </dd>

            <dt>
                Giá bán
            </dt>
            <dd>
                @string.Format("{0:N0} đ", Model.ProductPrice)
            </dd>

            <dt>
                Hình ảnh
            </dt>
            <dd>
                @if (!string.IsNullOrEmpty(Model.ProductImage))
                {
                    <img src="@Url.Content(Model.ProductImage)" width="150" height="150" style="object-fit: cover; border-radius: 6px; border: 1px solid #ddd;" />
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh</span>
                }
            </dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color" style="margin-top: 20px;">
                <input type="submit" value="Xóa" class="btn btn-danger" /> |
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>