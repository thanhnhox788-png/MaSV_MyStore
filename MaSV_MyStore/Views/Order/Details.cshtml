@model object

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    // Hàm phụ trợ dùng Reflection để đọc giá trị từ Model bất kể tên thuộc tính trong CSDL là gì
    Func<string, string> GetVal = (string propName) =>
    {
        var prop = Model.GetType().GetProperty(propName);
        return prop != null ? prop.GetValue(Model)?.ToString() : "";
    };

    string orderId = GetVal("OrderID") != "" ? GetVal("OrderID") : GetVal("MaDonHang");
    string customerName = GetVal("CustomerName") != "" ? GetVal("CustomerName") : GetVal("TenKhachHang");
    string phone = GetVal("Phone") != "" ? GetVal("Phone") : GetVal("SoDienThoai");
    string address = GetVal("Address") != "" ? GetVal("Address") : GetVal("DiaChi");
    string paymentMethod = GetVal("PaymentMethod") != "" ? GetVal("PaymentMethod") : GetVal("PhuongThucThanhToan");
    string orderDate = GetVal("OrderDate") != "" ? GetVal("OrderDate") : GetVal("NgayDat");
    string status = GetVal("Status") != "" ? GetVal("Status") : GetVal("TrangThai");
    string totalAmount = GetVal("TotalAmount") != "" ? GetVal("TotalAmount") : GetVal("TongTien");
}

<div class="container my-5">
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h2 class="fw-bold text-primary"><i class="fas fa-box-open me-2"></i>Đơn Hàng #@orderId</h2>
            <div>
                <!-- Hiển thị trạng thái đơn hàng -->
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 shadow-sm">
                    <i class="fas fa-shipping-fast me-1"></i> Trạng thái: @(string.IsNullOrEmpty(status) ? "Đang trung chuyển" : status)
                </span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h5 class="fw-bold text-secondary">Thông tin người nhận</h5>
                <p class="mb-1"><strong>Họ tên:</strong> @customerName</p>
                <p class="mb-1"><strong>Số điện thoại:</strong> @phone</p>
                <p class="mb-1"><strong>Địa chỉ giao:</strong> @address</p>
            </div>
            <div class="col-md-6 text-md-end">
                <h5 class="fw-bold text-secondary">Thông tin thanh toán</h5>
                <p class="mb-1"><strong>Ngày đặt:</strong> @orderDate</p>
                <p class="mb-1"><strong>Phương thức:</strong> <span class="text-success fw-bold">@paymentMethod</span></p>
            </div>
        </div>

        <h4 class="fw-bold mb-3">Sản phẩm đã đặt</h4>
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        // Lấy danh sách chi tiết đơn hàng linh hoạt
                        var detailsProp = Model.GetType().GetProperty("OrderDetails") ?? Model.GetType().GetProperty("ChiTietDonHangs");
                        var details = detailsProp != null ? detailsProp.GetValue(Model) as System.Collections.IEnumerable : null;
                    }

                    @if (details != null)
                    {
                        foreach (var detail in details)
                        {
                            var dType = detail.GetType();
                            string pId = dType.GetProperty("ProductID")?.GetValue(detail)?.ToString() ?? dType.GetProperty("MaSanPham")?.GetValue(detail)?.ToString();
                            string qty = dType.GetProperty("Quantity")?.GetValue(detail)?.ToString() ?? dType.GetProperty("SoLuong")?.GetValue(detail)?.ToString();
                            string price = dType.GetProperty("UnitPrice")?.GetValue(detail)?.ToString() ?? dType.GetProperty("GiaBan")?.GetValue(detail)?.ToString();

                            decimal pVal = 0, qVal = 0;
                            decimal.TryParse(price, out pVal);
                            decimal.TryParse(qty, out qVal);
                            decimal thanhTien = pVal * qVal;

                            <tr>
                                <td>Sản phẩm #@pId</td>
                                <td>@string.Format("{0:N0}", pVal) đ</td>
                                <td>@qty</td>
                                <td class="fw-bold text-danger">@string.Format("{0:N0}", thanhTien) đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Về trang chủ
            </a>
            <h3 class="text-danger fw-bold">
                Tổng thanh toán:
                @{
                    decimal totalVal = 0;
                    decimal.TryParse(totalAmount, out totalVal);
                }
                @string.Format("{0:N0}", totalVal) đ
            </h3>
        </div>
    </div>
</div>