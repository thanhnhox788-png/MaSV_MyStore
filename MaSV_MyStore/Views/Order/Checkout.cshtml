@model MaSV_MyStore.Models.ViewModels.Cart

@{
    ViewBag.Title = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h2 class="text-center fw-bold mb-4">Thanh Toán Đơn Hàng</h2>

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="row">
            <!-- Cột bên trái: Thông tin nhận hàng & Phương thức thanh toán -->
            <div class="col-md-7">
                <div class="card p-4 shadow-sm border-0 mb-4">
                    <h4 class="text-primary mb-3 fw-bold">📦 1. Địa chỉ nhận hàng</h4>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Họ và tên người nhận:</label>
                        <input type="text" name="customerName" class="form-control" maxlength="100" required placeholder="Nhập họ và tên đầy đủ..." />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Số điện thoại:</label>
                        <input type="tel" name="phone" class="form-control" maxlength="11" required placeholder="Nhập số điện thoại liên hệ..." />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Địa chỉ giao hàng chi tiết:</label>
                        <textarea name="address" class="form-control" rows="3" maxlength="200" required placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                    </div>

                    <!-- Phương thức thanh toán -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold mb-2">Phương thức thanh toán:</label>
                        <div class="payment-methods">

                            <!-- COD -->
                            <div class="payment-card d-flex align-items-center p-3 mb-2 border rounded cursor-pointer selected" onclick="selectPayment('COD')">
                                <input type="radio" name="paymentMethod" value="COD" checked class="form-check-input me-3" id="codRadio" />
                                <div>
                                    <span class="fw-bold d-block text-dark">Thanh toán khi nhận hàng (COD)</span>
                                    <small class="text-muted">Thanh toán bằng tiền mặt trực tiếp khi nhận hàng.</small>
                                </div>
                            </div>

                            <!-- Banking / QR Code -->
                            <div class="payment-card d-flex align-items-center p-3 mb-2 border rounded cursor-pointer" onclick="selectPayment('Banking')">
                                <input type="radio" name="paymentMethod" value="Banking" class="form-check-input me-3" id="bankingRadio" />
                                <div>
                                    <span class="fw-bold d-block text-dark">Chuyển khoản QR Ngân hàng</span>
                                    <small class="text-muted">Quét mã QR qua ứng dụng ngân hàng bất kỳ.</small>
                                </div>
                            </div>

                            <!-- MoMo -->
                            <div class="payment-card d-flex align-items-center p-3 border rounded cursor-pointer" onclick="selectPayment('MoMo')">
                                <input type="radio" name="paymentMethod" value="MoMo" class="form-check-input me-3" id="momoRadio" />
                                <div>
                                    <span class="fw-bold d-block text-danger">Ví điện tử MoMo</span>
                                    <small class="text-muted">Thanh toán nhanh chóng bằng ứng dụng MoMo.</small>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột bên phải: Tóm tắt đơn hàng -->
            <div class="col-md-5">
                <div class="card p-4 shadow-sm border-0 bg-light">
                    <h4 class="text-primary mb-3 fw-bold">🛒 Đơn hàng của bạn</h4>

                    <ul class="list-group mb-3">
                        @if (Model != null && Model.Items != null)
                        {
                            foreach (var item in Model.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <h6 class="my-0 fw-bold">@item.ProductName</h6>
                                        <small class="text-muted">Số lượng: @item.Quantity</small>
                                    </div>
                                    <span class="text-danger fw-bold">@item.Total.ToString("N0") đ</span>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between bg-white py-3">
                                <span class="fw-bold">Tổng tiền thanh toán:</span>
                                <strong class="text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</strong>
                            </li>
                        }
                    </ul>

                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold mb-2 shadow-sm">
                        <i class="fa fa-check-circle me-1"></i> ĐẶT HÀNG NGAY
                    </button>

                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại giỏ hàng
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- CSS bổ trợ giao diện phương thức thanh toán -->
<style>
    .cursor-pointer {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

    .payment-card:hover {
        background-color: #f8f9fa;
        border-color: #0d6efd !important;
    }

    .payment-card.selected {
        border-color: #198754 !important;
        background-color: #f1f8f5;
    }
</style>

<!-- Script tương tác chọn phương thức thanh toán -->
<script>
    function selectPayment(method) {
        document.querySelectorAll(".payment-card").forEach(c => c.classList.remove("selected"));
        if (method === 'COD') {
            document.getElementById('codRadio').checked = true;
            document.getElementById('codRadio').closest('.payment-card').classList.add('selected');
        } else if (method === 'Banking') {
            document.getElementById('bankingRadio').checked = true;
            document.getElementById('bankingRadio').closest('.payment-card').classList.add('selected');
        } else if (method === 'MoMo') {
            document.getElementById('momoRadio').checked = true;
            document.getElementById('momoRadio').closest('.payment-card').classList.add('selected');
        }
    }
</script>