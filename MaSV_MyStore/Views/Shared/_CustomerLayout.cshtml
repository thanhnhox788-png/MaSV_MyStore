<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MyStore</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar {
            background-color: rgba(26, 29, 33, 0.96) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.15);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
        }

        /* --- 🌟 HIỆU ỨNG LOGO VÀNG ĐỒNG SANG TRỌNG --- */
        .brand-logo-wrapper {
            display: inline-flex;
            align-items: center;
            text-decoration: none !important;
            padding: 4px 8px;
            border-radius: 12px;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

            .brand-logo-wrapper:hover {
                transform: translateY(-2px);
            }

        .brand-icon-box {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #1e1e2f 0%, #0f1016 100%);
            border: 1.5px solid rgba(245, 158, 11, 0.6);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.3);
            transition: all 0.4s ease;
        }

        .brand-logo-wrapper:hover .brand-icon-box {
            border-color: #f59e0b;
            box-shadow: 0 8px 25px rgba(245, 158, 11, 0.5);
            transform: rotate(-5deg) scale(1.05);
        }

        .brand-icon-box i {
            font-size: 1.25rem;
            background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-text-group {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .brand-title {
            font-weight: 800;
            font-size: 1.25rem;
            letter-spacing: 0.5px;
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-subtitle {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: #f59e0b;
        }

        /* --- 🎨 MÀU SẮC & HIỆU ỨNG CHO CÁC NÚT MENU --- */
        .navbar-nav .nav-link {
            font-weight: 600;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem !important;
            border-radius: 50rem;
            margin-left: 6px;
            margin-right: 2px;
        }

        /* Trang chủ */
        .nav-link-home {
            background-color: rgba(37, 99, 235, 0.15);
            color: #60a5fa !important;
            border: 1px solid rgba(96, 165, 250, 0.3);
        }

            .nav-link-home:hover {
                background-color: #2563eb !important;
                color: #ffffff !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
            }

        /* Đăng nhập */
        .nav-btn-login {
            background-color: rgba(124, 58, 237, 0.15);
            color: #a78bfa !important;
            border: 1px solid rgba(167, 139, 250, 0.3);
        }

            .nav-btn-login:hover {
                background-color: #7c3aed !important;
                color: #ffffff !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
            }

        /* Đăng ký */
        .nav-btn-register {
            background-color: rgba(13, 148, 136, 0.15);
            color: #2dd4bf !important;
            border: 1px solid rgba(45, 212, 191, 0.3);
        }

            .nav-btn-register:hover {
                background-color: #0d9488 !important;
                color: #ffffff !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(13, 148, 136, 0.4);
            }

        /* Nút Đăng xuất */
        .nav-btn-logout {
            background-color: rgba(220, 38, 38, 0.15);
            color: #f87171 !important;
            border: 1px solid rgba(248, 113, 113, 0.3);
        }

            .nav-btn-logout:hover {
                background-color: #dc2626 !important;
                color: #ffffff !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(220, 38, 38, 0.4);
            }

        /* Giỏ hàng: Nút nổi bật gradient cam hổ phách */
        .nav-btn-cart {
            background-color: rgba(245, 158, 11, 0.15) !important;
            color: #fbbf24 !important;
            border: 1px solid rgba(251, 191, 36, 0.3);
            transition: all 0.3s ease;
        }

            .nav-btn-cart:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4) !important;
                background-color: #f59e0b !important;
                color: #1a1d21 !important;
            }

        .body-content {
            flex: 1;
        }

        /* --- 🌟 FOOTER --- */
        .footer {
            background-color: #1e293b;
            color: #94a3b8;
            padding: 30px 0;
            margin-top: auto;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .hero {
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: white;
            padding: 60px 0;
            border-radius: 16px;
            margin-bottom: 40px;
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.2);
        }

        .card-product {
            border: none;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
            background: #ffffff;
        }

            .card-product:hover {
                transform: translateY(-6px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <!-- 🌟 LOGO VÀNG ĐỒNG SANG TRỌNG -->
            <a class="brand-logo-wrapper" href="@Url.Action("Index", "Home")">
                <div class="brand-icon-box me-2">
                    <i class="fas fa-crown"></i>
                </div>
                <div class="brand-text-group">
                    <span class="brand-title">MYSTORE</span>
                    <span class="brand-subtitle">BookStore</span>
                </div>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-1">
                    <li class="nav-item">
                        <a class="nav-link nav-link-home" href="@Url.Action("Index", "Home")">
                            <i class="fas fa-home me-1"></i> Trang chủ
                        </a>
                    </li>

                    <!-- KIỂM TRA TRẠNG THÁI ĐĂNG NHẬP VÀ HIỂN THỊ TÊN ĐỒNG BỘ TUYỆT ĐỐI -->
                    @if (Session["FullName"] != null || Session["Username"] != null || Session["Account"] != null || Session["Customer"] != null)
                    {
                        // Ưu tiên hiển thị FullName (Họ và tên đầy đủ), nếu không có mới lấy Username/Account
                        var fullName = Session["FullName"] ?? Session["Username"] ?? Session["Account"] ?? Session["Customer"] ?? "Khách hàng";

                        <li class="nav-item dropdown me-2 position-relative">
                            <!-- Nút hiển thị tên trên Navbar -->
                            <a class="nav-link dropdown-toggle text-warning fw-bold px-3 py-2 rounded-3 shadow-sm" href="javascript:void(0);" id="userDropdown" style="background-color: rgba(245, 158, 11, 0.12);">
                                <i class="fas fa-user-circle me-1"></i> Chào, @fullName
                            </a>

                            <!-- Menu thả xuống (Dropdown) -->
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2 mt-2 rounded-4" id="userDropdownMenu" style="position: absolute; right: 0; left: auto; width: 260px; background-color: #ffffff; display: none; z-index: 9999;">
                                <li class="px-3 py-2 border-bottom mb-1">
                                    <span class="small text-muted d-block">Xin chào,</span>
                                    <span class="fw-bold text-dark">@fullName</span>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 px-3 rounded-2 text-dark" href="@Url.Action("AccountProfile", "Account")">
                                        <i class="fas fa-user-circle text-primary me-2"></i>Thông tin tài khoản
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-2"></li>
                                <li>
                                    <a class="dropdown-item py-2 px-3 rounded-2 text-danger fw-bold" href="@Url.Action("Logout", "Account")">
                                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <!-- Khi chưa đăng nhập: Đăng nhập & Đăng ký -->
                        <li class="nav-item">
                            <a class="nav-link nav-btn-login" href="@Url.Action("Login", "Account")">
                                <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-btn-register" href="@Url.Action("Register", "Account")">
                                <i class="fas fa-user-plus me-1"></i> Đăng ký
                            </a>
                        </li>
                    }

                    <!-- Giỏ hàng -->
                    <li class="nav-item ms-lg-2">
                        <a class="nav-link nav-btn-cart px-4 fw-bold" href="@Url.Action("Index", "Cart")">
                            <i class="fas fa-shopping-cart me-1"></i> Giỏ hàng
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Nội dung trang -->
    <div class="container body-content mt-4 mb-5">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container text-center">
            <p class="mb-0 small">&copy; @DateTime.Now.Year - MyStore Application. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)

    <!-- ⭐️ SCRIPT ĐIỀU KHIỂN DROPDOWN HIỂN/ẨN CHÍNH XÁC -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var dropdownToggle = document.getElementById("userDropdown");
            var dropdownMenu = document.getElementById("userDropdownMenu");

            if (dropdownToggle && dropdownMenu) {
                dropdownToggle.addEventListener("click", function (e) {
                    e.stopPropagation();
                    if (dropdownMenu.style.display === "block") {
                        dropdownMenu.style.display = "none";
                    } else {
                        dropdownMenu.style.display = "block";
                    }
                });

                document.addEventListener("click", function (e) {
                    if (!dropdownToggle.contains(e.target) && !dropdownMenu.contains(e.target)) {
                        dropdownMenu.style.display = "none";
                    }
                });
            }
        });
    </script>
</body>
</html>