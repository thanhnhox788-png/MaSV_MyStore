<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hệ thống Quản trị MyStore</title>

    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9 !important;
            color: #2c3e50;
            margin: 0;
            padding: 0;
        }

        /* --- 🌟 SIDEBAR & LOGO ADMIN CAO CẤP --- */
        .admin-sidebar {
            background: linear-gradient(180deg, #1e1e2f 0%, #12121c 100%) !important;
            min-height: 100vh;
            box-shadow: 4px 0 25px rgba(0, 0, 0, 0.08);
            position: fixed;
            top: 0;
            left: 0;
            width: 260px;
            z-index: 1000;
        }

        .admin-brand-logo {
            display: flex;
            align-items: center;
            padding: 20px;
            text-decoration: none !important;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 10px;
        }

        .admin-logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1a1d21;
            font-size: 1.2rem;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
            margin-right: 12px;
        }

        .admin-logo-text {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .admin-logo-title {
            font-weight: 800;
            font-size: 1.15rem;
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 0.5px;
        }

        .admin-logo-sub {
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #f59e0b;
        }

        /* Menu điều hướng Sidebar */
        .admin-nav-link {
            color: #94a3b8 !important;
            padding: 12px 20px;
            font-weight: 500;
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
            text-decoration: none !important;
            border-left: 3px solid transparent;
        }

            .admin-nav-link:hover, .admin-nav-link.active {
                color: #ffffff !important;
                background-color: rgba(255, 255, 255, 0.06);
                border-left-color: #f59e0b;
            }

            .admin-nav-link i {
                margin-right: 12px;
                font-size: 1.1rem;
            }

        /* Khu vực nội dung chính bên phải */
        .admin-main-content {
            margin-left: 260px;
            padding: 20px;
        }

        /* Topbar hệ thống */
        .admin-topbar {
            background: #ffffff;
            padding: 15px 30px;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Nút quay lại website chính */
        .btn-view-website {
            background-color: rgba(30, 41, 59, 0.06);
            color: #1e293b;
            border: 1px solid rgba(30, 41, 59, 0.15);
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none !important;
        }

            .btn-view-website:hover {
                background-color: #1e293b;
                color: #ffffff;
            }

        @@media (max-width: 768px) {
            .admin-sidebar {
                width: 100%;
                position: relative;
                min-height: auto;
            }

            .admin-main-content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <!-- 🌟 SIDEBAR ĐIỀU HƯỚNG BÊN TRÁI -->
    <div class="admin-sidebar">
        <!-- Logo MyStore Admin cao cấp -->
        <a href="@Url.Action("Index", "Admin")" class="admin-brand-logo">
            <div class="admin-logo-icon">
                <i class="fas fa-crown"></i>
            </div>
            <div class="admin-logo-text">
                <span class="admin-logo-title">MYSTORE</span>
                <span class="admin-logo-sub">Administration</span>
            </div>
        </a>

        <!-- Danh sách menu -->
        <div class="nav flex-column mt-3">
            <a href="@Url.Action("Index", "Admin")" class="admin-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                <i class="fas fa-chart-line text-warning"></i> Tổng quan
            </a>
            <a href="@Url.Action("Products", "Admin")" class="admin-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Products" ? "active" : "")">
                <i class="fas fa-boxes text-primary"></i> Quản lý sản phẩm
            </a>
            <a href="@Url.Action("Orders", "Admin")" class="admin-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Orders" || ViewContext.RouteData.Values["action"].ToString() == "Details" ? "active" : "")">
                <i class="fas fa-shopping-cart text-success"></i> Quản lý đơn hàng
            </a>
            <a href="@Url.Action("Customers", "Admin")" class="admin-nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Customers" ? "active" : "")">
                <i class="fas fa-users text-info"></i> Quản lý khách hàng
            </a>

            <div class="px-3 mt-4">
                <a href="@Url.Action("Index", "Home")" class="btn-view-website d-block text-center py-2">
                    <i class="fas fa-globe me-2"></i> Xem Website chính
                </a>
            </div>
        </div>
    </div>

    <!-- 🌟 NỘI DUNG CHÍNH BÊN PHẢI -->
    <div class="admin-main-content">
        <!-- Topbar tiêu đề -->
        <div class="admin-topbar">
            <div class="d-flex align-items-center">
                <i class="fas fa-user-shield text-warning fs-4 me-2"></i>
                <h5 class="fw-bold mb-0 text-dark">Hệ thống Quản trị Viên</h5>
            </div>
            <div>
                <span class="text-muted small">Xin chào, <strong>Admin</strong></span>
            </div>
        </div>

        <!-- Render nội dung các trang con (Index, Details, Products...) -->
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>