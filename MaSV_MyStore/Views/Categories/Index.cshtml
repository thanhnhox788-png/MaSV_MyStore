@model IEnumerable<MaSV_MyStore.Models.Product>

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;">
    <h2>DANH SÁCH SẢN PHẨM</h2>

    <p style="margin-bottom: 20px;">
        @Html.ActionLink("Thêm mới sản phẩm", "Create", null, new { @class = "btn btn-primary" })
    </p>

    <table class="table table-striped table-bordered table-hover">
        <tr class="info">
            <th>
                Danh mục
            </th>
            <th>
                Tên sản phẩm
            </th>
            <th>
                Mô tả
            </th>
            <th>
                Giá bán
            </th>
            <th>
                Hình ảnh
            </th>
            <th style="width: 150px; text-align: center;">Thao tác</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Category.CategoryName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductDescription)
                </td>
                <td>
                    @string.Format("{0:N0} đ", item.ProductPrice)
                </td>
                <td style="text-align: center;">
                    @if (!string.IsNullOrEmpty(item.ProductImage))
                    {
                        <img src="@Url.Content(item.ProductImage)" width="60" height="60" style="object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" />
                    }
                    else
                    {
                        <span class="text-muted">Chưa có ảnh</span>
                    }
                </td>
                <td style="text-align: center;">
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-warning btn-xs" }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-info btn-xs" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-xs" })
                </td>
            </tr>
        }
    </table>
</div>