@model IEnumerable<MaSV_MyStore.Models.Category>

@{
    ViewBag.Title = "Danh sách danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;">
    <h2>DANH SÁCH DANH MỤC</h2>

    <p style="margin-bottom: 20px;">
        @Html.ActionLink("Thêm mới danh mục", "Create", null, new { @class = "btn btn-primary" })
    </p>

    <table class="table table-striped table-bordered table-hover">
        <tr class="info">
            <th>Tên danh mục</th>
            <th style="width: 200px; text-align: center;">Thao tác</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CategoryName)
                </td>
                <td style="text-align: center;">
                    @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-warning btn-sm" }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-info btn-sm" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </table>
</div>