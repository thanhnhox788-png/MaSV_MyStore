@model MaSV_MyStore.Models.ViewModels.RegisterVM

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-8 col-lg-7">
            <!-- Thêm thẻ card bọc ngoài với hiệu ứng nổi khối và bo góc lớn -->
            <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-white">

                <!-- Tiêu đề và biểu tượng trang trí sang trọng -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle shadow-sm mb-3" style="width: 65px; height: 65px;">
                        <i class="fas fa-user-plus fa-lg"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Tạo Tài Khoản Mới</h3>
                    <p class="text-muted small">Trở thành thành viên của MyStore ngay hôm nay</p>
                </div>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 py-2 small mb-3" })

                    <div class="row">
                        <!-- Tên đăng nhập -->
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Username, "Tên đăng nhập", new { @class = "form-label small fw-bold text-secondary text-uppercase" })
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-at"></i></span>
                                @Html.TextBoxFor(m => m.Username, new { @class = "form-control bg-light border-0 py-2", maxlength = "50", placeholder = "Nhập tên đăng nhập" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Họ và tên -->
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.FullName, "Họ và tên", new { @class = "form-label small fw-bold text-secondary text-uppercase" })
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-user"></i></span>
                                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control bg-light border-0 py-2", maxlength = "100", placeholder = "Nhập họ và tên" })
                            </div>
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <div class="row">
                        <!-- Mật khẩu -->
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "form-label small fw-bold text-secondary text-uppercase" })
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-key"></i></span>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control bg-light border-0 py-2", maxlength = "100", placeholder = "Nhập mật khẩu" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.ConfirmPassword, "Xác nhận mật khẩu", new { @class = "form-label small fw-bold text-secondary text-uppercase" })
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-lock"></i></span>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control bg-light border-0 py-2", maxlength = "100", placeholder = "Nhập lại mật khẩu" })
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <!-- Số điện thoại + Mã quốc gia -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Số điện thoại</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-phone-alt"></i></span>
                            <select class="form-select bg-light border-0" style="max-width: 130px;" name="CountryCode">
                                <option value="+84" selected>+84 (VN)</option>
                                <option value="+1">+1 (US)</option>
                                <option value="+81">+81 (JP)</option>
                                <option value="+82">+82 (KR)</option>
                                <option value="+86">+86 (CN)</option>
                                <option value="+65">+65 (SG)</option>
                                <option value="+66">+66 (TH)</option>
                                <option value="+60">+60 (MY)</option>
                                <option value="+62">+62 (ID)</option>
                                <option value="+63">+63 (PH)</option>
                                <option value="+44">+44 (UK)</option>
                                <option value="+33">+33 (FR)</option>
                                <option value="+49">+49 (DE)</option>
                                <option value="+61">+61 (AU)</option>
                            </select>

                            @Html.TextBoxFor(m => m.Phone, new
                            {
                                @class = "form-control bg-light border-0 py-2",
                                maxlength = "10",
                                placeholder = "Nhập 9-10 số điện thoại"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label small fw-bold text-secondary text-uppercase" })
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-envelope"></i></span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light border-0 py-2", maxlength = "100", placeholder = "Nhập email của bạn" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Địa chỉ -->
                    <div class="mb-4">
                        @Html.LabelFor(m => m.Address, "Địa chỉ", new { @class = "form-label small fw-bold text-secondary text-uppercase" })
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-map-marker-alt"></i></span>
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control bg-light border-0 py-2", maxlength = "100", placeholder = "Nhập địa chỉ giao hàng" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Nút Đăng ký nổi bật -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-warning text-dark fw-bold py-2.5 rounded-3 shadow-sm transition-all">
                            <i class="fas fa-user-check me-2"></i> Đăng Ký Tài Khoản
                        </button>
                    </div>
                }

                <!-- Chuyển hướng đăng nhập -->
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Đã có tài khoản?
                        @Html.ActionLink("Đăng nhập ngay", "Login", null, new { @class = "text-warning fw-bold text-decoration-none ms-1" })
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Hiệu ứng chuyển động mượt mà cho nút -->
<style>
    .transition-all {
        transition: all 0.3s ease;
    }

        .transition-all:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(245, 158, 11, 0.3) !important;
        }
</style>