@model MaSV_MyStore.Models.ViewModels.LoginVM

@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center" style="min-height: 65vh;">
        <div class="col-md-5 col-lg-4">
            <!-- Thêm hiệu ứng card nổi, bo góc mượt mà -->
            <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-white">

                <!-- Tiêu đề và biểu tượng trang trí -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle shadow-sm mb-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-lock fa-lg"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Đăng Nhập</h3>
                    <p class="text-muted small">Chào mừng bạn quay trở lại MyStore</p>
                </div>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3 py-2 small mb-3" })

                    <!-- Tên đăng nhập -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Username, new { @class = "form-label small fw-bold text-secondary text-uppercase" })
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-user"></i></span>
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control bg-light border-0 py-2", placeholder = "Nhập tên đăng nhập..." })
                        </div>
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label small fw-bold text-secondary text-uppercase" })
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted"><i class="fas fa-key"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control bg-light border-0 py-2", placeholder = "••••••••" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Ghi nhớ đăng nhập -->
                    <div class="mb-4 form-check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label text-muted small" })
                    </div>

                    <!-- Nút đăng nhập nổi bật -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-warning text-dark fw-bold py-2.5 rounded-3 shadow-sm transition-all">
                            <i class="fas fa-sign-in-alt me-2"></i> Đăng Nhập
                        </button>
                    </div>
                }

                <!-- Đăng ký nhanh -->
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Chưa có tài khoản?
                        @Html.ActionLink("Đăng ký ngay", "Register", null, new { @class = "text-warning fw-bold text-decoration-none ms-1" })
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Hiệu ứng chuyển động mượt mà cho nút -->
<style>
    .transition-all {
        transition: all 0.3s ease;
    }

        .transition-all:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(245, 158, 11, 0.3) !important;
        }
</style>