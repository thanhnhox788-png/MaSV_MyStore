@model IEnumerable<MaSV_MyStore.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container py-5">
    <!-- Tiêu đề trang -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1 d-flex align-items-center">
                <span class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 me-3 fs-4 shadow-sm">
                    <i class="fas fa-shopping-bag"></i>
                </span>
                Đơn hàng của tôi
            </h2>
            <p class="text-muted small mb-0 ms-1">Theo dõi trạng thái, ngày giờ và chi tiết các đơn hàng bạn đã mua trên hệ thống</p>
        </div>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark rounded-pill px-4 fw-bold shadow-sm transition-hover">
            <i class="fas fa-arrow-left me-2"></i> Tiếp tục mua sắm
        </a>
    </div>

    <!-- 1. CÁC TAB TRẠNG THÁI ĐƠN HÀNG (Thiết kế dạng Pill thanh lịch, hiện đại) -->
    <div class="d-flex flex-wrap gap-2 mb-4 p-2 bg-white rounded-4 shadow-sm border">
        @{
            string[] statuses = { "Tất cả", "Chờ thanh toán", "Đang xử lý", "Đang vận chuyển", "Đã giao", "Đã hủy" };
            foreach (var s in statuses)
            {
                bool isActive = (string.IsNullOrEmpty(currentStatus) && s == "Tất cả") || currentStatus == s;
                string activeClass = isActive ? "bg-primary text-white shadow" : "bg-light text-dark border-0 hover-bg-primary";
                <a href="@Url.Action("MyOrders", new { status = s })" class="btn rounded-pill px-3 py-2 fw-semibold small transition-all @activeClass">
                    @s
                </a>
            }
        }
    </div>

    <!-- 2. THANH TÌM KIẾM ĐƠN HÀNG -->
    @using (Html.BeginForm("MyOrders", "Account", FormMethod.Get, new { @class = "mb-4" }))
    {
        <input type="hidden" name="status" value="@currentStatus" />
        <div class="row g-2 align-items-center">
            <div class="col-md-10 position-relative">
                <span class="position-absolute top-50 translate-middle-y ms-3 text-muted">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" name="searchString" class="form-control form-control-lg rounded-pill ps-5 shadow-sm border bg-white" value="@ViewBag.SearchString" placeholder="Nhập mã đơn hàng hoặc tên sản phẩm để tìm kiếm...">
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-lg w-100 fw-bold shadow-sm rounded-pill transition-hover" type="submit">
                    <i class="fas fa-search me-1"></i> Tìm kiếm
                </button>
            </div>
        </div>
    }

    <!-- Kiểm tra nếu có đơn hàng -->
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            // 🌟 ĐỌC CHUẨN XÁC TRẠNG THÁI REAL-TIME TỪ CƠ SỞ DỮ LIỆU
            string statusText = "Đang xử lý";
            string badgeClass = "text-warning bg-warning";
            string iconClass = "fa-shipping-fast";

            try
            {
                var val = item.GetType().GetProperty("OrderStatus")?.GetValue(item)?.ToString()
                       ?? item.GetType().GetProperty("TrangThai")?.GetValue(item)?.ToString()
                       ?? item.GetType().GetProperty("Status")?.GetValue(item)?.ToString();
                if (!string.IsNullOrEmpty(val)) { statusText = val; }
            }
            catch { }

            // Tự động phân loại màu sắc và icon theo đúng trạng thái thực tế
            if (statusText.Contains("thành công") || statusText.Contains("Đã giao") || statusText.Contains("Hoàn thành"))
            {
                badgeClass = "text-success bg-success";
                iconClass = "fa-check-circle";
            }
            else if (statusText.Contains("hủy") || statusText.Contains("Hủy"))
            {
                badgeClass = "text-danger bg-danger";
                iconClass = "fa-times-circle";
            }
            else if (statusText.Contains("vận chuyển") || statusText.Contains("Đang giao"))
            {
                badgeClass = "text-info bg-info";
                iconClass = "fa-truck";
            }

            <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white overflow-hidden transition-card">
                <div class="card-body p-4">
                    <!-- Header đơn hàng -->
                    <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                        <div>
                            <span class="fw-bold @badgeClass bg-opacity-10 border border-opacity-25 px-3 py-2 rounded-pill shadow-sm">
                                <i class="fas @iconClass me-1"></i> @statusText
                            </span>
                            <span class="text-muted small ms-2">Mã đơn: <strong class="text-dark">#@item.OrderID</strong></span>
                        </div>
                        <span class="text-muted small">
                            <i class="far fa-clock text-muted me-1"></i> @item.OrderDate
                        </span>
                    </div>

                    <!-- Danh sách sản phẩm trong đơn hàng -->
                    <div class="order-items-list mb-3">
                        @if (item.OrderDetails != null && item.OrderDetails.Any())
                        {
                            foreach (var detail in item.OrderDetails)
                            {
                                string pName = detail.Product != null ? detail.Product.ProductName : "Sản phẩm";
                                string rawImg = detail.Product != null ? detail.Product.ProductImage : "";
                                string pImg = "";
                                string nameLower = pName.ToLower();

                                // 🌟 XỬ LÝ ẢNH THÔNG MINH CHO TỪNG SÁCH TRÁNH LỖI MẤT HÌNH
                                if (nameLower.Contains("conan"))
                                {
                                    pImg = "https://cdn1.fahasa.com/media/catalog/product/t/h/tham-tu-lung-danh-conan_tap-23_-tb-2023.jpg";
                                }
                                else if (nameLower.Contains("babylon") || nameLower.Contains("giàu nhất"))
                                {
                                    pImg = "https://upload.wikimedia.org/wikipedia/vi/0/04/Ng%C6%B0%E1%BB%9Di_gi%C3%A0u_c%C3%B3_nh%E1%BA%A5t_th%C3%A0nh_Babylon.jpg";
                                }
                                else if (nameLower.Contains("tâm lý") || nameLower.Contains("đám đông"))
                                {
                                    pImg = "https://pos.nvncdn.com/fd5775-40602/ps/20240115_0ajcFr7hKU.jpeg?v=1705298977";
                                }
                                else
                                {
                                    pImg = !string.IsNullOrEmpty(rawImg) && rawImg.StartsWith("http")
                                                ? rawImg
                                                : "https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=500&q=80";
                                }

                                decimal lineTotal = detail.Quantity * detail.UnitPrice;

                                <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light">
                                    <div class="d-flex align-items-center">
                                        <img src="@pImg" alt="@pName" class="rounded border me-3 shadow-sm" style="width: 60px; height: 80px; object-fit: cover;">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">@pName</h6>
                                            <span class="text-muted small">Số lượng: x@(detail.Quantity)</span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold text-danger">@string.Format("{0:N0}", lineTotal) đ</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small fst-italic mb-0">Đang cập nhật chi tiết sản phẩm.</p>
                        }
                    </div>

                    <!-- Footer đơn hàng -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <div>
                            <span class="text-muted">Tổng tiền đơn hàng: </span>
                            <span class="fs-5 fw-bold text-danger">
                                @{
                                    decimal totalAmount = 0;
                                    if (item.OrderDetails != null)
                                    {
                                        totalAmount = item.OrderDetails.Sum(d => d.Quantity * d.UnitPrice);
                                    }
                                }
                                @string.Format("{0:N0}", totalAmount) đ
                            </span>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("BuyAgain", "Cart", new { orderId = item.OrderID })" class="btn btn-sm btn-success px-3 rounded-pill fw-bold shadow-sm btn-action-buy">
                                <i class="fas fa-redo me-1"></i> Mua lại
                            </a>
                            <a href="@Url.Action("Details", "Account", new { id = item.OrderID })" class="btn btn-sm btn-primary px-3 rounded-pill fw-bold shadow-sm btn-action-view">
                                <i class="fas fa-eye me-1"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- 3. THÔNG BÁO KHI CHƯA CÓ ĐƠN HÀNG -->
        <div class="text-center py-5 card shadow-sm border-0 rounded-4 bg-white">
            <div class="card-body py-5">
                <i class="fas fa-box-open fa-4x text-primary opacity-50 mb-3"></i>
                <h5 class="fw-bold text-dark mb-2">BẠN CHƯA CÓ ĐƠN HÀNG NÀO</h5>
                <p class="text-muted small mb-4">Khám phá ngay các sản phẩm phong phú và sở hữu những món đồ yêu thích của bạn.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm">
                    <i class="fas fa-home me-2"></i> Đến trang chủ
                </a>
            </div>
        </div>
    }
</div>

<!-- HIỆU ỨNG CSS CAO CẤP -->
<style>
    .fs-7 {
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    .order-items-list > div:last-child {
        border-bottom: none !important;
    }

    .btn-action-view, .btn-action-buy, .transition-hover {
        transition: all 0.25s ease;
    }

        .btn-action-view:hover, .btn-action-buy:hover, .transition-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.12) !important;
        }

    .transition-card {
        transition: all 0.3s ease;
    }

        .transition-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
        }

    .hover-bg-primary:hover {
        background-color: #f1f3f5 !important;
    }
</style>