@model MaSV_MyStore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var oModel = Model;
    string orderId = "";
    try { orderId = (oModel.GetType().GetProperty("OrderID")?.GetValue(oModel) ?? oModel.GetType().GetProperty("MaDonHang")?.GetValue(oModel))?.ToString(); } catch { }

    string customerId = "";
    try { customerId = (oModel.GetType().GetProperty("CustomerID")?.GetValue(oModel) ?? oModel.GetType().GetProperty("MaKhachHang")?.GetValue(oModel))?.ToString(); } catch { }

    // 🌟 ĐỌC TRẠNG THÁI HIỆN TẠI TỪ CƠ SỞ DỮ LIỆU
    string currentStatus = "Đang xử lý";
    try
    {
        var statusVal = oModel.GetType().GetProperty("OrderStatus")?.GetValue(oModel)
                     ?? oModel.GetType().GetProperty("TrangThai")?.GetValue(oModel)
                     ?? oModel.GetType().GetProperty("Status")?.GetValue(oModel);
        if (statusVal != null && !string.IsNullOrEmpty(statusVal.ToString()))
        {
            currentStatus = statusVal.ToString().Trim();
        }
    }
    catch { }

    // Phân loại màu badge theo trạng thái
    string badgeColor = "bg-warning text-dark";
    if (currentStatus.Contains("thành công") || currentStatus.Contains("Đã giao"))
    {
        badgeColor = "bg-success text-white";
    }
    else if (currentStatus.Contains("hủy") || currentStatus.Contains("Hủy"))
    {
        badgeColor = "bg-danger text-white";
    }
    else if (currentStatus.Contains("vận chuyển"))
    {
        badgeColor = "bg-info text-dark";
    }

    // Xử lý định dạng ngày giờ đặt hàng chuẩn xác
    string orderDateStr = "N/A";
    try
    {
        var rawDate = oModel.GetType().GetProperty("OrderDate")?.GetValue(oModel) ?? oModel.GetType().GetProperty("NgayDat")?.GetValue(oModel);
        if (rawDate != null)
        {
            if (rawDate is DateTime dt)
            {
                orderDateStr = dt.ToString("dd/MM/yyyy HH:mm");
            }
            else
            {
                DateTime parsedDt;
                if (DateTime.TryParse(rawDate.ToString(), out parsedDt))
                {
                    orderDateStr = parsedDt.ToString("dd/MM/yyyy HH:mm");
                }
                else
                {
                    orderDateStr = rawDate.ToString();
                }
            }
        }
    }
    catch { }
}

<div class="container my-4">
    <div class="card shadow-sm p-4 border-0 rounded-4">
        <h2 class="fw-bold mb-4 text-primary">
            <i class="fas fa-file-invoice me-2"></i>Chi tiết đơn hàng #@orderId
        </h2>

        <!-- Thông tin chung đơn hàng & Form cập nhật trạng thái -->
        <div class="row mb-4 bg-light p-3 rounded-4 align-items-center">
            <div class="col-md-5">
                <p class="mb-2"><strong>Mã khách hàng:</strong> @(string.IsNullOrEmpty(customerId) ? "N/A" : customerId)</p>
                <p class="mb-0"><strong>Ngày giờ đặt:</strong> <span class="text-dark fw-bold">@orderDateStr</span></p>
            </div>

            <div class="col-md-3 text-md-center my-2 my-md-0">
                <p class="mb-1 text-muted small">Trạng thái hiện tại:</p>
                <span class="badge @badgeColor px-3 py-2 fs-6 fw-bold">@currentStatus</span>
            </div>

            <!-- 🌟 FORM CẬP NHẬT TRẠNG THÁI (Giao hàng thành công / Hủy / Đang xử lý...) -->
            <div class="col-md-4">
                @using (Html.BeginForm("UpdateStatus", "Order", new { area = "" }, FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
                {
                    <input type="hidden" name="orderId" value="@orderId" />
                    <select name="newStatus" class="form-select form-select-sm rounded-pill">
                        <option value="Chờ thanh toán" @(currentStatus == "Chờ thanh toán" ? "selected" : "")>Chờ thanh toán</option>
                        <option value="Đang xử lý" @(currentStatus == "Đang xử lý" ? "selected" : "")>Đang xử lý</option>
                        <option value="Đang vận chuyển" @(currentStatus == "Đang vận chuyển" ? "selected" : "")>Đang vận chuyển</option>
                        <option value="Giao hàng thành công" @(currentStatus.Contains("thành công") || currentStatus.Contains("Đã giao") ? "selected" : "")>Giao hàng thành công</option>
                        <option value="Đã hủy" @(currentStatus.Contains("hủy") ? "selected" : "")>Đã hủy</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm text-nowrap">
                        <i class="fas fa-save me-1"></i> Cập nhật
                    </button>
                }
            </div>
        </div>

        <h4 class="fw-bold mb-3"><i class="fas fa-boxes me-2"></i>Danh sách sản phẩm khách đặt</h4>

        <!-- Bảng danh sách sản phẩm trong đơn hàng -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        decimal totalOrderAmount = 0;
                        var details = ViewBag.OrderDetails as IEnumerable<object>;
                        if (details != null)
                        {
                            foreach (var item in details)
                            {
                                string pName = item.GetType().GetProperty("ProductName")?.GetValue(item)?.ToString() ?? "Sản phẩm";
                                string pImg = item.GetType().GetProperty("ProductImage")?.GetValue(item)?.ToString() ?? "";
                                decimal price = Convert.ToDecimal(item.GetType().GetProperty("Price")?.GetValue(item) ?? item.GetType().GetProperty("DonGia")?.GetValue(item) ?? 0);
                                int qty = Convert.ToInt32(item.GetType().GetProperty("Quantity")?.GetValue(item) ?? item.GetType().GetProperty("SoLuong")?.GetValue(item) ?? 0);
                                decimal subTotal = price * qty;
                                totalOrderAmount += subTotal;

                                <tr>
                                    <td style="width: 90px;" class="text-center">
                                        <img src="@pImg" alt="@pName" style="width: 60px; height: 60px; object-fit: cover;" class="rounded border shadow-sm" />
                                    </td>
                                    <td class="fw-bold text-start">@pName</td>
                                    <td class="text-danger fw-bold">@price.ToString("N0") đ</td>
                                    <td class="text-center"><span class="badge bg-secondary px-2 py-1">@qty</span></td>
                                    <td class="text-success fw-bold">@subTotal.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Tổng cộng đơn hàng -->
        <div class="d-flex justify-content-end mt-3">
            <h4 class="fw-bold text-danger">Tổng giá trị đơn hàng: @totalOrderAmount.ToString("N0") đ</h4>
        </div>

        <div class="mt-4">
            <a href="@Url.Action("Orders", "Admin")" class="btn btn-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách đơn hàng
            </a>
        </div>
    </div>
</div>