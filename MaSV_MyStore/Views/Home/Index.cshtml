@model MaSV_MyStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!-- Hero Banner -->
<div class="hero text-center mb-5">
    <div class="container">
        <h1 class="display-5 fw-bold mb-3">Chào mừng đến với MyStore</h1>
        <p class="lead mb-4">Khám phá hàng ngàn sản phẩm chất lượng với giá tốt nhất</p>
    </div>
</div>

<!-- ====================== SẢN PHẨM NỔI BẬT ====================== -->
<h3 class="mb-4 fw-bold">
    <i class="fas fa-star text-warning me-2"></i>Sản phẩm nổi bật
</h3>

<div class="row g-4 mb-5">
    @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
    {
        foreach (var item in Model.FeaturedProducts)
        {
            string imgPath = "";
            if (!string.IsNullOrEmpty(item.ProductName) && item.ProductName.Contains("Conan"))
            {
                imgPath = "ĐIỀN_LINK_ANH_CONAN_CỦA_BẠN_VÀO_ĐÂY";
            }
            else if (!string.IsNullOrEmpty(item.ProductName) && (item.ProductName.Contains("Babylon") || item.ProductName.Contains("giàu nhất")))
            {
                imgPath = "https://upload.wikimedia.org/wikipedia/vi/0/04/Ng%C6%B0%E1%BB%9Di_gi%C3%A0u_c%C3%B3_nh%E1%BA%A5t_th%C3%A0nh_Babylon.jpg";
            }
            else if (!string.IsNullOrEmpty(item.ProductName) && item.ProductName.Contains("Tâm Lý Học"))
            {
                // ⭐️ ĐÃ GÁN LINK ẢNH TÂM LÝ HỌC ĐÁM ĐÔNG CỦA BẠN ⭐️
                imgPath = "https://cdn1.fahasa.com/media/flashmagazine/images/page_images/tam_ly_hoc_dam_dong/2024_08_26_11_34_56_1-390x510.jpg";
            }
            else
            {
                string dbImage = !string.IsNullOrEmpty(item.ProductImage) ? item.ProductImage.Trim() : "";
                imgPath = string.IsNullOrEmpty(dbImage)
                    ? "https://via.placeholder.com/300x200?text=No+Image"
                    : Url.Content("~/Content/images/" + dbImage);
            }

            <div class="col-md-3 col-sm-6">
                <div class="card card-product h-100">
                    <img src="@imgPath"
                         class="card-img-top"
                         style="height: 200px; object-fit: cover;"
                         alt="@item.ProductName" />

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.ProductName</h5>
                        <p class="card-text text-muted small">
                            @(string.IsNullOrEmpty(item.ProductDescription) ? "" :
                              (item.ProductDescription.Length > 60
                                ? item.ProductDescription.Substring(0, 60) + "..."
                                : item.ProductDescription))
                        </p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">
                                @string.Format("{0:N0}", item.ProductPrice) ₫
                            </span>
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })"
                               class="btn btn-sm btn-outline-primary">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">Chưa có sản phẩm nổi bật.</div>
        </div>
    }
</div>

<!-- ====================== SẢN PHẨM MỚI ====================== -->
<h3 class="mb-4 fw-bold">
    <i class="fas fa-box-open text-primary me-2"></i>Sản phẩm mới
</h3>

<div class="row g-4">
    @if (Model.NewProducts != null && Model.NewProducts.Any())
    {
        foreach (var item in Model.NewProducts)
        {
            string imgPath = "";
            if (!string.IsNullOrEmpty(item.ProductName) && item.ProductName.Contains("Conan"))
            {
                imgPath = "https://cdn1.fahasa.com/media/catalog/product/t/h/tham-tu-lung-danh-conan_tap-23_-tb-2023.jpg";
            }
            else if (!string.IsNullOrEmpty(item.ProductName) && (item.ProductName.Contains("Babylon") || item.ProductName.Contains("giàu nhất")))
            {
                imgPath = "https://upload.wikimedia.org/wikipedia/vi/0/04/Ng%C6%B0%E1%BB%9Di_gi%C3%A0u_c%C3%B3_nh%E1%BA%A5t_th%C3%A0nh_Babylon.jpg";
            }
            else if (!string.IsNullOrEmpty(item.ProductName) && item.ProductName.Contains("Tâm Lý Học"))
            {
                // ⭐️ ĐÃ GÁN LINK ẢNH TÂM LÝ HỌC ĐÁM ĐÔNG CỦA BẠN ⭐️
                imgPath = "https://cdn1.fahasa.com/media/flashmagazine/images/page_images/tam_ly_hoc_dam_dong/2024_08_26_11_34_56_1-390x510.jpg";
            }
            else
            {
                string dbImage = !string.IsNullOrEmpty(item.ProductImage) ? item.ProductImage.Trim() : "";
                imgPath = string.IsNullOrEmpty(dbImage)
                    ? "https://via.placeholder.com/300x200?text=No+Image"
                    : Url.Content("~/Content/images/" + dbImage);
            }

            <div class="col-md-3 col-sm-6">
                <div class="card card-product h-100">
                    <img src="@imgPath"
                         class="card-img-top"
                         style="height: 200px; object-fit: cover;"
                         alt="@item.ProductName" />

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.ProductName</h5>
                        <p class="card-text text-muted small">
                            @(string.IsNullOrEmpty(item.ProductDescription) ? "" :
                              (item.ProductDescription.Length > 60
                                ? item.ProductDescription.Substring(0, 60) + "..."
                                : item.ProductDescription))
                        </p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">
                                @string.Format("{0:N0}", item.ProductPrice) ₫
                            </span>
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })"
                               class="btn btn-sm btn-outline-primary">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-warning">Chưa có sản phẩm nào.</div>
        </div>
    }
</div>

<!-- Phân trang -->
<div class="mt-4">
    @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
</div>