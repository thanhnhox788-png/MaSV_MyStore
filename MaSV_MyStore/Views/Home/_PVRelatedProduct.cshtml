@model MaSV_MyStore.Models.ViewModels.ProductDetailVM

@if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
{
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var item in Model.RelatedProducts)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                        <img src="~/Images/@item.ProductImage"
                             class="card-img-top"
                             style="height: 180px; object-fit: cover;"
                             alt="@item.ProductName" />
                    </a>
                    <div class="card-body">
                        <h6 class="card-title text-truncate">
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })"
                               class="text-decoration-none text-dark">
                                @item.ProductName
                            </a>
                        </h6>
                        <p class="text-danger fw-bold mb-0">
                            @string.Format("{0:N0}", item.ProductPrice) đ
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">Không có sản phẩm tương tự.</p>
}