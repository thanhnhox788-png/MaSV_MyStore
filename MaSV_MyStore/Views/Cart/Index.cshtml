@model MaSV_MyStore.Models.ViewModels.Cart

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml"; // Giữ đúng layout chung của trang bạn
}

<div class="container my-5">
    <h2 class="fw-bold mb-4">Giỏ hàng của bạn</h2>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-warning text-center p-4">
            <h4>Giỏ hàng của bạn đang trống!</h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 120px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn giá</th>
                        <th style="width: 150px;">Số lượng</th>
                        <th>Thành tiền</th>
                        <th style="width: 80px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        // Xử lý hiển thị ảnh linh hoạt (ảnh online cho Conan hoặc ảnh từ CSDL)
                        string imgPath = "";
                        if (!string.IsNullOrEmpty(item.ProductName) && item.ProductName.Contains("Conan"))
                        {
                            imgPath = "https://cdn1.fahasa.com/media/catalog/product/t/h/tham-tu-lung-danh-conan_tap-23_-tb-2023.jpg";
                        }
                        else if (!string.IsNullOrEmpty(item.ProductImage))
                        {
                            imgPath = Url.Content("~/Content/images/" + item.ProductImage.Trim());
                        }
                        else
                        {
                            imgPath = "https://via.placeholder.com/100x120?text=No+Image";
                        }

                        <tr>
                            <td>
                                <img src="@imgPath" alt="@item.ProductName" class="img-fluid rounded" style="width: 70px; height: 90px; object-fit: cover;" />
                            </td>
                            <td class="text-start fw-bold">@item.ProductName</td>
                            <td class="text-danger fw-bold">@item.ProductPrice.ToString("N0") đ</td>
                            <td>
                                <!-- Form cập nhật số lượng trực tiếp trong giỏ hàng -->
                                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-flex justify-content-center align-items-center" }))
                                {
                                    <input type="hidden" name="productId" value="@item.ProductID" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control text-center me-2" style="width: 70px;" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Cập nhật số lượng">Cập nhật</button>
                                }
                            </td>
                            <td class="text-danger fw-bold">@item.Total.ToString("N0") đ</td>
                            <td>
                                <a href="@Url.Action("RemoveFromCart", "Cart", new { productId = item.ProductID })" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">
                                    <i class="fas fa-trash-alt"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded shadow-sm">
            <div>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Tiếp tục mua hàng
                </a>
                <a href="@Url.Action("ClearCart", "Cart")" class="btn btn-outline-danger ms-2" onclick="return confirm('Bạn có muốn xóa toàn bộ giỏ hàng không?');">
                    Xóa giỏ hàng
                </a>
            </div>

            <div class="text-end">
                <h4 class="mb-2">Tổng cộng: <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</span></h4>
                <a href="@Url.Action("Checkout", "Order")" class="btn btn-success btn-lg px-5">
                    Thanh toán <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
</div>